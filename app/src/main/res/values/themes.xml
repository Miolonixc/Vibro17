<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.Vibro17" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/cyan</item>
        <item name="colorPrimaryVariant">@color/cyan_dim</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorSecondary">@color/cyan</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:colorBackground">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:statusBarColor">@color/black</item>
        <item name="android:navigationBarColor">@color/black</item>
        <item name="android:windowBackground">@color/black</item>
        <item name="vibroAccent">@color/cyan</item>
        <item name="vibroAccentDim">@color/cyan_dim</item>
    </style>

    <!-- Classic green accent -->
    <style name="Theme.Vibro17Classic" parent="Theme.Vibro17">
        <item name="colorPrimary">@color/green</item>
        <item name="colorSecondary">@color/green</item>
        <item name="colorPrimaryVariant">@color/green_dim</item>
        <item name="vibroAccent">@color/green</item>
        <item name="vibroAccentDim">@color/green_dim</item>
    </style>

    <!-- Amber accent -->
    <style name="Theme.Vibro17Amber" parent="Theme.Vibro17">
        <item name="colorPrimary">@color/amber</item>
        <item name="colorSecondary">@color/amber</item>
        <item name="colorPrimaryVariant">@color/amber_dim</item>
        <item name="vibroAccent">@color/amber</item>
        <item name="vibroAccentDim">@color/amber_dim</item>
    </style>
</resources>
