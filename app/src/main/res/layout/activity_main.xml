<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="16dp">

    <TextView
        android:id="@+id/titleMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_main"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="0.15"
        android:textColor="@color/cyan"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <View
        android:id="@+id/liveDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="12dp"
        android:background="@drawable/bg_dot"
        android:visibility="invisible"
        app:layout_constraintBottom_toBottomOf="@id/titleMain"
        app:layout_constraintStart_toEndOf="@id/titleMain"
        app:layout_constraintTop_toTopOf="@id/titleMain" />

    <TextView
        android:id="@+id/subtitleMain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/subtitle_main"
        android:textSize="13sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintTop_toBottomOf="@id/titleMain"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:padding="10dp"
        android:background="@drawable/bg_status"
        android:text="@string/status_idle"
        android:textColor="@color/cyan_glow"
        android:textSize="14sp"
        app:layout_constraintTop_toBottomOf="@id/subtitleMain"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <LinearLayout
        android:id="@+id/toolsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintTop_toBottomOf="@id/statusText"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.miolonixc.vibro17.ui.VisualizerView
            android:id="@+id/visualizer"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_weight="1" />

        <Button
            android:id="@+id/exportBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:text="EXP"
            android:textSize="13sp"
            android:contentDescription="Экспорт"
            android:backgroundTint="@color/surface_raised"
            android:textColor="@color/cyan" />

        <Button
            android:id="@+id/importBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="IMP"
            android:textSize="13sp"
            android:contentDescription="Импорт"
            android:backgroundTint="@color/surface_raised"
            android:textColor="@color/cyan" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/effectGrid"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="14dp"
        android:scrollbars="vertical"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintTop_toBottomOf="@id/toolsRow"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/editorFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Редактор"
        android:src="@android:drawable/ic_menu_edit"
        app:backgroundTint="@color/surface_raised"
        app:tint="@color/cyan"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/stopFab"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        android:contentDescription="Стоп"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        app:backgroundTint="@color/cyan"
        app:tint="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
